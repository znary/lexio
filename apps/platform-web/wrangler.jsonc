{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lexio-platform-web",
  "compatibility_date": "2026-04-14",
  "routes": [
    {
      "pattern": "lexio.fromreviews.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
